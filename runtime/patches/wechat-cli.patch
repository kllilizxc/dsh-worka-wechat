@@ -0,0 +1,17 @@
+package main
+
+import "testing"
+
+func TestFileHelperResolvesWithoutMetadataCache(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	s := &server{}
+	for _, key := range []string{"talker", "chat"} {
+		got, err := s.resolveLooseChatArg(map[string]any{key: "filehelper"})
+		if err != nil || got != "filehelper" {
+			t.Fatalf("%s: got %q, %v", key, got, err)
+		}
+	}
+	if looksLikeRawChatID("文件传输助手") {
+		t.Fatal("display name must still use metadata resolution")
+	}
+}
