{
  "name": "dsh-worka-wechat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "本机微信只读便笺",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bridge",
    "template",
    "worka.json",
    "cordis.patch.yml",
    "README.md",
    "runtime"
  ],
  "dsh": {
